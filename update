#!/bin/bash
if [ -f ./nvim-linux-x86_64.appimage ]; then
    rm ./nvim-linux-x86_64.appimage
fi

wget https://github.com/neovim/neovim/releases/download/stable/nvim-linux-x86_64.appimage
chmod +x ./nvim-linux-x86_64.appimage
./nvim-linux-x86_64.appimage --appimage-extract

if [ -d /squashfs-root ]; then
    rm -rf /squashfs-root/*
    rm -f /squashfs-root/.* 2> /dev/null
fi

if ! [ -d /squashfs-root ]; then
    mkdir /squashfs-root
fi

mv ./squashfs-root/* /squashfs-root
rm -rf ./squashfs-root ./nvim-linux-x86_64.appimage
